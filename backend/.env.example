# Copy to .env and edit. NEVER commit the real .env file.
PORT=5000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# --- Supabase (hosted PostgreSQL) ---
# Supabase dashboard -> Connect -> "Session pooler" URI. Replace [YOUR-PASSWORD].
# Do NOT append ?sslmode=... to the URL.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres
DB_SSL=true

# Only needed for `npm test`. MUST be a DIFFERENT database: tests wipe all tables.
# TEST_DATABASE_URL=
